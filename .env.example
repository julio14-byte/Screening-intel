# Credenciales del proyecto de Supabase
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (Vercel / local)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (chat / LangGraph agent)
OPENAI_API_KEY=

# WHO ICD-11 API (perfil clínico + MCP icd11)
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=

# Stripe — Fase 1 SaaS (suscripciones mensuales)
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Opcional hoy (Checkout hosted); reservado para futuro
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Dashboard → Webhooks → endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
# Dashboard → Products → Price ID del plan mensual Pro (price_...)
STRIPE_PRICE_ID_PRO=price_...
# Opcional — plan Pro+
STRIPE_PRICE_ID_PRO_PLUS=price_...

# Login de prueba — usuario demo (auto-creado en primer login si existe service_role)
# Authentication → Users → Add user (marcar Auto Confirm User) si no usas auto-provisión
DEMO_LOGIN_EMAIL=demo@screening.local
DEMO_LOGIN_PASSWORD=demo123

# MCP server local: yarn mcp:screening
# Requiere NEXT_PUBLIC_SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY en el entorno.
